void initFileSystem() {
  fileSystemConfig.setAutoFormat(false);
  fileSystem->setConfig(fileSystemConfig);
  fsOK = fileSystem->begin();
  if (!fsOK) {
    // Never formatted, or the flash layout changed after flashing. Without a
    // filesystem nothing can be saved ("Failed to open wifi.json for writing").
    Serial.println(F("Filesystem mount failed - formatting..."));
    fsOK = fileSystem->format() && fileSystem->begin();
  }
  Serial.println(fsOK ? F("Filesystem initialized.") : F("Filesystem init failed!"));
}

// Static files (kbSensors.css/js/svg): LittleFS first, then the copies embedded in the
// firmware (assets.h, generated by embed_assets.py), so the UI works even when data/
// was never uploaded.
bool sendEmbeddedAsset(const String &name) {
  for (const EmbeddedAsset &a : embeddedAssets) {
    if (name == a.name) {
      server.sendHeader("Cache-Control", "max-age=3600");
      server.send_P(200, a.contentType, a.data, a.size);
      return true;
    }
  }
  return false;
}

// Serves one of the static files (kbSensors.css/js/svg).
// Always sends a response: 503 when there is no filesystem, 404 when the file is missing.
bool handleFileDownload(String path) {
  String name = path.startsWith("/") ? path.substring(1) : path;

  if (!fsOK) {
    if (sendEmbeddedAsset(name))
      return true;
    server.send(503, "text/plain", F("Filesystem not available."));
    return false;
  }

  if (!path.startsWith("/")) {
    path = "/" + path;
  }
  if (path.endsWith("/")) {
    path += "index.htm";
  }

  String contentType;
  if (server.hasArg("download")) {
    contentType = F("application/octet-stream");
  } else {
    contentType = mime::getContentType(path);
  }

  if (!fileSystem->exists(path)) {
    // File not found, try gzip version
    path = path + ".gz";
  }
  if (fileSystem->exists(path)) {
    File file = fileSystem->open(path, "r");
    if (server.streamFile(file, contentType) != file.size()) {
      Serial.println("Sent less data than expected!");
    }
    file.close();
    return true;
  }

  if (sendEmbeddedAsset(name))
    return true;

  server.send(404, "text/plain", F("Not found."));
  return false;
}
#endif

void handleClientAskingAboutSensors(String desiredFormat) {
  Serial.println("  Client requested " + desiredFormat);
  if ((desiredFormat == "txt") || (desiredFormat == "text")) {
    server.send(200, "text/plain", sendTXT());
    registerForceUpdate(1);
  } else if (desiredFormat == "xml") {
    server.send(200, "text/xml", sendXML());
    registerForceUpdate(1);
  } else if (desiredFormat == "json") {
    server.send(200, "application/json", sendJSON());
    registerForceUpdate(1);
  } else {
    uint16_t refreshPageDuration = 0;
    if (server.hasArg("refresh")) {
      long r = server.arg("refresh").toInt(); // 0 for garbage
      refreshPageDuration = (uint16_t)constrain(r, 0L, 86400L);
    }
    server.send(200, "text/html", sendHTML(refreshPageDuration));
    registerForceUpdate(2);
  }
  blink();
}

void handleReboot() {
  if (!webOpenEdit && !requireWebAuth())
    return;
  Serial.println("Reboot request!");
  server.send(200,
      "text/html",
      F("<html><head><meta http-equiv=\"refresh\" "
        "content=\"10;url=/\"></head><body>Reboot in "
        "progress...</body></html>"));
  blink(3);
  delay(2000); // 2s to allow user to download the page
  ESP.restart();
}

void handleRescan() {
  if (!webOpenEdit && !requireWebAuth())
    return;
  Serial.println("Rescan request!");
  server.send(200,
      "text/html",
      F("<html><head><meta http-equiv=\"refresh\" "
        "content=\"2;url=/\"></head><body>Rescan in "
        "progress...</body></html>"));
  registerForceUpdate(1);
  blink(4);
}

void handleEdit() {
  if (!webOpenEdit && !requireWebAuth())
    return;

  String sensorAddressStr = "";
  String sensorNewFriendlyNameStr = "";
  float sensorNewCompensation = 0;

  // get arguments from URL
  for (uint8_t i = 0; i < server.args(); i++) {
    if (server.argName(i) == "address") {
      sensorAddressStr = server.arg(i);
    } else if (server.argName(i) == "friendlyName") {
      sensorNewFriendlyNameStr = server.arg(i);
    } else if (server.argName(i) == "compensation") {
      sensorNewCompensation = atof(server.arg(i).c_str());
    }
  }

  // basic validation
  if ((sensorAddressStr == "") || (sensorNewFriendlyNameStr == "")) {
    Serial.println("Incorrect arguments.");
    server.send(403,
        "text/plain",
        "Arguments error. Use "
        "?address=123456789ABCDEF0&friendlyName=new_name&compensation=1.5");
    return;
  }

  // Address validation: a sensor we already know (DHTtemp, CCS811eCO2, DS18B20...)
  // or a new 16-character HEX address.
  if (findSensorByAddress(sensorAddressStr.c_str()) < 0) {
    sensorAddressStr.toUpperCase(); // HEX wielkimi literami
    if (sensorAddressStr.length() != 16) {
      server.send(403, "text/plain", "Unknown sensor. A new address must be 16 hexadecimal characters.");
      Serial.println("Invalid address length.");
      return;
    }
    for (char c : sensorAddressStr) {
      if (!isxdigit(c)) {
        server.send(403, "text/plain", "Address must contain only HEX characters (0-9, A-F).");
        Serial.println("Invalid address characters.");
        return;
      }
    }
  }

  // FriendlyName validation (max 32 chars, only safe characters)
  if (sensorNewFriendlyNameStr.length() > 32) {
    server.send(403, "text/plain", "Friendly name too long (max 32 characters).");
    Serial.println("Friendly name too long.");
    return;
  }
  for (char c : sensorNewFriendlyNameStr) {
    if (c < 32 || c == '<' || c == '>' || c == '&' || c == '"' || c == '\'') {
      server.send(403, "text/plain", "Friendly name contains invalid characters.");
      Serial.println("Friendly name has unsafe characters.");
      return;
    }
  }

  // conversion String -> char[]
  char sensorAddress[17];         // 16 znaków HEX + '\0'
  char sensorNewFriendlyName[33]; // 32 znaki nazwy + '\0'
  sensorAddressStr.toCharArray(sensorAddress, sizeof(sensorAddress));
  sensorNewFriendlyNameStr.toCharArray(sensorNewFriendlyName, sizeof(sensorNewFriendlyName));

  // Debug
  Serial.printf("New name of sensor %s is %s; compensation = %.2f", sensorAddress, sensorNewFriendlyName, sensorNewCompensation);
  Serial.println();

  if (editSensor(sensorAddress, sensorNewFriendlyName, sensorNewCompensation)) {
    saveConfig();
    server.send(200, "text/plain", "Sensor saved!");
    Serial.println("Sensor saved.");
  } else {
    server.send(403, "text/plain", "Error while saving sensor.");
    Serial.println("Error while saving sensor (Sensor not found & no space for more).");
  }
}

// Returns true on success, false if sensor not found and no space for more
bool editSensor(const char *sensorAddress, const char *newFriendlyName, float newCompensation) {
  for (uint16_t i = 0; i < sensorsCount; i++) {
    if (strncmp(sensorsSettings[i].address, sensorAddress, sizeof(sensorsSettings[i].address)) == 0) {
      // Aktualizacja istniejącego sensora
      strlcpy(sensorsSettings[i].name, newFriendlyName, sizeof(sensorsSettings[i].name));
      sensorsSettings[i].compensation = newCompensation;
      return true;
    }
  }

  // If not found, add new sensor if there is space
  if (sensorsCount < MAX_SENSORS) {
    strlcpy(sensorsSettings[sensorsCount].address, sensorAddress, sizeof(sensorsSettings[sensorsCount].address));
    strlcpy(sensorsSettings[sensorsCount].name, newFriendlyName, sizeof(sensorsSettings[sensorsCount].name));
    sensorsSettings[sensorsCount].compensation = newCompensation;
    sensorsSettings[sensorsCount].present = false; // newly added sensor = not checked as present yet
    sensorsCount++;
    return true;
  }

  // Brak miejsca
  return false;
}

String sendHTML(uint16_t refreshPageDuration) {
  String valueString;
  float value;

  String ptr = "<!DOCTYPE html>\n";
  ptr += "<html>\n";
  ptr += "<head>\n";
  ptr += "  <meta name=\"viewport\" content=\"width=device-width, "
         "initial-scale=1.0\">\n";
  ptr += "  <meta charset=\"UTF-8\">\n";
  ptr += "  <title>" + (String)programName + "</title>\n";
  ptr += "  <link rel=\"stylesheet\" href=\"/kbSensors.css\">\n";
  ptr += "  <script src=\"/kbSensors.js\" defer></script>\n";
  ptr += "  <link rel=\"icon\" href=\"/kbSensors.svg\" type=\"image/svg+xml\">\n";
  ptr += "  <meta name=\"generator\" content=\"" + (String)programName + " " + (String)programVersion + "\">\n";
  ptr += "  <meta name=\"description\" content=\"" + (String)programManual + "\">\n";

  if (refreshPageDuration > 0) {
    ptr += "  <meta http-equiv=\"refresh\" content=\"" + (String)refreshPageDuration + "\">\n";
  }

  ptr += "</head>\n";
  ptr += "<body><form><div id=\"webpage\">\n";
  ptr += "<h1>" + (String)programName + "</h1>\n";

  if (sensorsCount > 0) {
    ptr += "<table>\n";
    for (uint16_t i = 0; i < sensorsCount; i++) {
      SensorConfig s = sensorsSettings[i];
      if (!s.present) {
        continue;
      }

      ptr += "<tr>\n";
      ptr += "  <td title=\"" + htmlEscape(s.address) + "\">" + htmlEscape(s.name) + "\n";
      value = s.lastValue + s.compensation;
      if (value < 0) {
        valueString = (String) "&minus;" + (String)(-value);
      } else {
        valueString = (String)value;
      }
      ptr += "  <td title=\"" + (String)(s.compensation) + "\">" + valueString + (String)getSensorUnits(s) + "\n";
      ptr += "</tr>\n";
    }

    /* nav */
    ptr += "<tr>\n";
    ptr += "  <td colspan=\"2\" id=\"navtr\">\n";
    ptr += "    <div id=\"settingsContainer\">\n";
    ptr += "      <span id=\"settingsIcon\">⚙️</span>\n";
    ptr += "      <nav id=\"settingsMenu\">\n";
    ptr += "        <a href=\"/\" onclick=\"refreshPage(event);\">refresh "
           "page</a> | \n";
    ptr += "        <a href=\"reboot\">reboot kbSensors</a> | \n";
    ptr += "        <a href=\"rescan\">rescan sensors</a> | \n";
    ptr += "        <a href=\"wifi\">settings</a> | \n";
    ptr += "        <a href=\"mqtt\">mqtt</a>\n";
    ptr += "      </nav>\n";
    ptr += "    </div>\n";
    ptr += "  </td>\n";
    ptr += "</tr>\n";

    ptr += "</table>\n";
  }

  ptr += "</div></form></body>\n";
  ptr += "</html>";
  return ptr;
}

String sendXML() {
  String ptr = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n";
  ptr += "<report>\n";

  for (uint16_t i = 0; i < sensorsCount; i++) {
    SensorConfig s = sensorsSettings[i];
    if (!s.present) {
      continue;
    }

    ptr += "<sensor address=\"" + htmlEscape(s.address) + "\">\n";
    ptr += "  <name>" + htmlEscape(s.name) + "</name>\n";
    ptr += "  <value>" + String(s.lastValue + s.compensation) + "</value>\n";
    ptr += "  <type>" + String(sensorTypeStrs[s.type]) + "</type>\n";
    ptr += "</sensor>\n";
  }
  ptr += "</report>";
  return ptr;
}

String makeSafeName(const char *unsafeName) {
  String safe = unsafeName; // konwersja char[] -> String
  safe.replace(" ", "_");   // zamiana spacji na _
  return safe;
}

String sendTXT() {
  String output = "";

  for (uint16_t i = 0; i < sensorsCount; i++) {
    SensorConfig s = sensorsSettings[i];
    if (!s.present) {
      continue;
    }

    float adjustedValue = s.lastValue + s.compensation;
    output += makeSafeName(s.name) + ".value " + String(adjustedValue, 2) + "\n";
  }

  return output;
}

String sendJSON() {
  // Built by hand: a fixed-size ArduinoJson document silently truncated the output
  // once there were more than a dozen sensors.
  String out = F("{\"sensors\":[");
  bool first = true;

  for (uint16_t i = 0; i < sensorsCount; i++) {
    const SensorConfig &s = sensorsSettings[i];
    if (!s.present) {
      continue;
    }
    if (!first) {
      out += ',';
    }
    first = false;

    out += F("{\"name\":\"");
    out += jsonEscape(s.name);
    out += F("\",\"address\":\"");
    out += jsonEscape(s.address);
    out += F("\",\"value\":");
    out += jsonNumber(s.lastValue);
    out += F(",\"compensation\":");
    out += jsonNumber(s.compensation);
    out += F(",\"type\":\"");
    out += getSensorType(s);
    out += F("\"}");
  }

  out += F("]}");
  return out;
}

// Beginning of a settings page (head + title).
String settingsPageStart(const __FlashStringHelper *title) {
  String html = F("<!DOCTYPE html><html><head><meta charset='UTF-8'>"
                  "<meta name='viewport' content='width=device-width, initial-scale=1.0'>"
                  "<link rel='stylesheet' href='/kbSensors.css'>"
                  "<script src='/kbSensors.js'></script><title>");
  html += title;
  html += F("</title></head><body><h2>");
  html += title;
  html += F("</h2>");
  return html;
}

String errorMessage(const String &text) { return "<p style='color:red'>" + text + "</p>"; }

void sendWiFiForm(const String &message) {
  String html = settingsPageStart(F("WiFi Configuration"));
  html += message;
  html += F("<form method='POST' onsubmit='return validateWebPasswordForm();'>");
  html += F("SSID: <input name='ssid' maxlength='32' value='");
  html += htmlEscape(wifiSSID);
  html += F("'><br>");
  // Passwords are never sent back to the browser: an empty field means "unchanged".
  html += F("WiFi password: <input name='wifipassword' type='password' maxlength='63' placeholder='(unchanged)' autocomplete='new-password'><br>");
  html += F("<label><input type='checkbox' name='wifiopen'> open network (no password)</label><hr>");
  html += F("<input type='hidden' name='wifiForm' value='1'>");
  html += F("Username: <input name='webuser' maxlength='32' value='");
  html += htmlEscape(webUser);
  html += F("'><br>");
  html += F("New WWW password: <input name='webpass' type='password' placeholder='(unchanged)' autocomplete='new-password'><br>");
  html += F("Confirm WWW password: <input name='webpass2' type='password' autocomplete='new-password'><br>");
  html += F("<label><input type='checkbox' name='openedit'");
  html += webOpenEdit ? F(" checked") : F("");
  html += F("> Allow sensor edit without password</label> <small>(also reboot and rescan)</small><hr>");
  html += F("<input type='submit' value='Save'>");
  html += F("</form></body></html>");

  server.send(200, "text/html", html);
}

void handleWiFiPage() {
  if (!requireWebAuth())
    return;

  String message = defaultPasswordWarning();

  if (server.method() == HTTP_POST) {
    // Collect and validate everything first; nothing is changed (and the device is
    // not restarted) unless all of it is valid.
    String newSsid = server.hasArg("ssid") ? server.arg("ssid") : wifiSSID;
    String newWifiPass = wifiPassword;
    String typedWifiPass = server.arg("wifipassword");
    String newUser = server.hasArg("webuser") ? server.arg("webuser") : webUser;
    String newWebPass = webPass;
    bool newOpenEdit = server.hasArg("wifiForm") ? server.hasArg("openedit") : webOpenEdit;
    String pass1 = server.arg("webpass");
    String pass2 = server.arg("webpass2");
    String error;

    if (server.hasArg("wifiopen")) {
      newWifiPass = "";
    } else if (typedWifiPass.length() > 0) {
      newWifiPass = typedWifiPass;
    }

    if (newSsid.length() == 0 || newSsid.length() > 32) {
      error = F("SSID must have 1-32 characters.");
    } else if (typedWifiPass.length() > 0 && !server.hasArg("wifiopen") && (typedWifiPass.length() < 8 || typedWifiPass.length() > 63)) {
      error = F("WiFi password must have 8-63 characters.");
    } else if (newUser.length() == 0 || newUser.length() > 32 || newUser.indexOf(':') >= 0) {
      error = F("Username must have 1-32 characters and must not contain ':'.");
    } else if (pass1.length() > 0 || pass2.length() > 0) {
      if (pass1 != pass2) {
        error = F("WWW passwords do not match.");
      } else if (pass1.length() < 6) {
        error = F("WWW password must have at least 6 characters.");
      } else if (pass1 == "admin") {
        error = F("WWW password must differ from the default one.");
      } else {
        newWebPass = pass1;
      }
    } else if (isDefaultWebPassword()) {
      error = F("Set a new WWW password - the default one must be changed.");
    }

    if (error.length() == 0) {
      String oldSsid = wifiSSID, oldWifiPass = wifiPassword, oldUser = webUser, oldWebPass = webPass;
      bool oldOpenEdit = webOpenEdit;
      wifiSSID = newSsid;
      wifiPassword = newWifiPass;
      webUser = newUser;
      webPass = newWebPass;
      webOpenEdit = newOpenEdit;

      if (saveWiFiConfig()) {
        server.send(200,
            "text/html",
            F("<html><head><meta charset='UTF-8'><meta http-equiv=\"refresh\" "
              "content=\"10;url=/\"></head><body>Settings saved. Reboot "
              "in progress...</body></html>"));
        blink(3);
        delay(2000); // 2s to allow user to download the page
        ESP.restart();
        return;
      }

      wifiSSID = oldSsid;
      wifiPassword = oldWifiPass;
      webUser = oldUser;
      webPass = oldWebPass;
      webOpenEdit = oldOpenEdit;
      error = F("Could not write the settings to flash. Nothing was changed.");
    }

    message += errorMessage(error);
  }

  sendWiFiForm(message);
}

// <select> + source + parameter inputs for one environment-compensation channel.
String importOptions(int selected) {
  static const char *const labels[] = {"Brak", "MQTT Topic", "JSON URL", "Lokalny Sensor"};
  String o;
  for (int i = 0; i < 4; i++) {
    o += F("<option value='");
    o += i;
    o += '\'';
    if (i == selected) {
      o += F(" selected");
    }
    o += '>';
    o += labels[i];
    o += F("</option>");
  }
  return o;
}

String importInputs(const char *prefix, const EnvCompensationConfig &c) {
  String h = "<select id='" + String(prefix) + "Method' name='" + String(prefix) + "Method' onchange='toggleRemoteInputs()'>";
  h += importOptions((int)c.method);
  h += F("</select>");
  h += "<input type='text' id='" + String(prefix) + "Source' name='" + String(prefix) + "Source' placeholder='URL lub Temat MQTT' value='" + htmlEscape(c.source) + "'>";
  h += "<input type='text' id='" + String(prefix) + "Param' name='" + String(prefix) + "Param' placeholder='Adres sensora (dla JSON)' value='" + htmlEscape(String(c.address)) + "'>";
  return h;
}

void handleMQTTPage() {
  if (!requireWebAuth())
    return;

  String message = defaultPasswordWarning();

  if (server.method() == HTTP_POST) {
    // Log the field names only - the values include the broker password.
    Serial.print(F("MQTT form POST, fields:"));
    for (int i = 0; i < server.args(); i++) {
      Serial.print(' ');
      Serial.print(server.argName(i));
    }
    Serial.println();

    String host = server.arg("host");
    host.trim();
    if (host.length() > 0)
      mqtt.host = host;
    if (server.hasArg("port")) {
      long p = server.arg("port").toInt();
      if (p >= 1 && p <= 65535)
        mqtt.port = (uint16_t)p;
    }
    if (server.hasArg("user"))
      mqtt.user = server.arg("user");
    // The password is never sent back to the browser: empty field = unchanged.
    if (server.arg("pass").length() > 0)
      mqtt.pass = server.arg("pass");
    if (server.hasArg("clearpass"))
      mqtt.pass = "";
    if (server.arg("baseTopic").length() > 0)
      mqtt.baseTopic = server.arg("baseTopic");
    // Browsers do not send unchecked checkboxes at all, so for the HTML form
    // (marked with mqttForm) a missing field means "off". Other clients
    // (curl etc.) keep the old behaviour: only change what they send.
    if (server.hasArg("mqttForm")) {
      mqtt.enabled = server.arg("enabled") == "on";
      mqtt.retain = server.arg("retain") == "on";
    } else {
      if (server.hasArg("enabled"))
        mqtt.enabled = server.arg("enabled") == "on";
      if (server.hasArg("retain"))
        mqtt.retain = server.arg("retain") == "on";
    }
    if (server.hasArg("qos"))
      mqtt.qos = constrain(server.arg("qos").toInt(), 0, 1); // PubSubClient supports QoS 0 and 1

    if (server.hasArg("remTempMethod"))
      config.compTemp.method = (ImportMethod)constrain(server.arg("remTempMethod").toInt(), 0, 3);
    if (server.hasArg("remTempSource"))
      config.compTemp.source = server.arg("remTempSource");
    if (server.hasArg("remTempParam")) {
      strlcpy(config.compTemp.address, server.arg("remTempParam").c_str(), sizeof(config.compTemp.address));
    }

    if (server.hasArg("remHumiMethod"))
      config.compHumi.method = (ImportMethod)constrain(server.arg("remHumiMethod").toInt(), 0, 3);
    if (server.hasArg("remHumiSource"))
      config.compHumi.source = server.arg("remHumiSource");
    if (server.hasArg("remHumiParam")) {
      strlcpy(config.compHumi.address, server.arg("remHumiParam").c_str(), sizeof(config.compHumi.address));
    }

    bool reset = server.hasArg("reset");
    if (reset) {
      mqtt = MQTTConfig(); // przywróć domyślne wartości
    }

    bool saved = saveConfig();
    saved = saveMQTTConfig() && saved;
    mqttApplyConfig();

    if (!saved) {
      message = errorMessage(F("Settings applied, but could not be written to flash (they will be lost on reboot)."));
    } else {
      message = reset ? F("<p>MQTT settings reset to defaults</p>") : F("<p>MQTT settings saved</p>");
    }
    server.send(200,
        "text/html",
        F("<html><head><meta charset='UTF-8'><meta http-equiv=\"refresh\" "
          "content=\"2;url=/\"></head><body>") +
            message + F("</body></html>"));
    blink(3);
    return;
  }

  // Formularz HTML
  String html = settingsPageStart(F("MQTT Configuration"));
  html += message;
  html += F("<form method='POST'>");
  html += F("<input type='hidden' name='mqttForm' value='1'>");
  html += F("Host: <input name='host' value='");
  html += htmlEscape(mqtt.host);
  html += F("'><br>Port: <input name='port' value='");
  html += String(mqtt.port);
  html += F("'><br>User: <input name='user' value='");
  html += htmlEscape(mqtt.user);
  html += F("'><br>");
  // Passwords are never sent back to the browser: an empty field means "unchanged".
  html += F("Password: <input name='pass' type='password' placeholder='(unchanged)' autocomplete='new-password'>");
  html += F(" <label><input type='checkbox' name='clearpass'> no password</label><br>");
  html += F("Base Topic: <input name='baseTopic' value='");
  html += htmlEscape(mqtt.baseTopic);
  html += F("'><br>");
  html += F("Enabled: <input type='checkbox' name='enabled'");
  html += mqtt.enabled ? F(" checked") : F("");
  html += F("><br>QoS: <input name='qos' value='");
  html += String(mqtt.qos);
  html += F("'><br>Retain: <input type='checkbox' name='retain'");
  html += mqtt.retain ? F(" checked") : F("");
  html += F("><br><hr>");
  //
  // temporarily here as we should think about reconstructing the settings page.
  html += F("<fieldset><legend> Kompensacja srodowiskowa (dla CCS811)</legend>");
  html += F("<h4>Temperatura</h4>");
  html += importInputs("remTemp", config.compTemp);
  html += F("<br /><h4>Wilgotnosc</h4>");
  html += importInputs("remHumi", config.compHumi);
  html += F("</fieldset><hr>");
  html += F("<input type='submit' value='Save'>");
  html += F(" <input type='submit' name='reset' value='Reset to defaults'>");
  html += F("</form><script>if (window.toggleRemoteInputs) toggleRemoteInputs();</script></body></html>");

  server.send(200, "text/html", html);
}

void handleWebserver() { server.handleClient(); }
